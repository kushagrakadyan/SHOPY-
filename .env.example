# Base URL for the future Express/Node backend.
# Until the backend is live, the service layer (see src/services) uses
# mock data and this variable is unused.
VITE_API_BASE_URL=http://localhost:5000/api

# Public key only - never put secret keys in a frontend .env file.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

VITE_CLOUDINARY_CLOUD_NAME=replace_me
VITE_CLOUDINARY_UPLOAD_PRESET=replace_me
