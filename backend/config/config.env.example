PORT=4000
FRONTEND_URL=http://localhost:3000
# Comma-separated origins are supported, e.g. a local app and its Vercel URL.
# FRONTEND_URL=https://your-app.vercel.app,http://localhost:3000
NODE_ENV=development

# Database
DB_URI=mongodb://127.0.0.1:27017/ecommerce
DB_HOSTED_URI=

# JWT
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_EXPIRES_IN=90d
COOKIE_EXPIRES=90

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_SERVICE=
SMTP_MAIL=
SMTP_PASSWORD=

# Pagination
RESULT_PER_PAGE=12

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_BUCKET_REGION=

# Stripe (optional)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Twilio (optional)
ACCOUNT_SID=
AUTH_TOKEN=

# AI / Redis
GEMINI_API_KEY=
REDIS_HOSTED_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# reCAPTCHA (optional)
reCAPTCHA_SECRET_KEY=

# Amazon SES (optional)
SES_SENDER_EMAIL=
